<view class="page data-v-12bbc91e"><view class="header data-v-12bbc91e"><view class="header-top data-v-12bbc91e"><view class="greeting data-v-12bbc91e"><text class="greeting-text data-v-12bbc91e">{{a}}</text><text class="user-name data-v-12bbc91e">{{b}}</text></view><view class="avatar data-v-12bbc91e">😊</view></view><view wx:if="{{c}}" class="countdown-card data-v-12bbc91e"><text class="countdown-label data-v-12bbc91e">距 {{d}} 考试还有</text><view class="countdown-nums data-v-12bbc91e"><view class="countdown-item data-v-12bbc91e"><text class="countdown-num data-v-12bbc91e">{{e}}</text><text class="countdown-unit data-v-12bbc91e">天</text></view><text class="countdown-sep data-v-12bbc91e">:</text><view class="countdown-item data-v-12bbc91e"><text class="countdown-num data-v-12bbc91e">{{f}}</text><text class="countdown-unit data-v-12bbc91e">时</text></view><text class="countdown-sep data-v-12bbc91e">:</text><view class="countdown-item data-v-12bbc91e"><text class="countdown-num data-v-12bbc91e">{{g}}</text><text class="countdown-unit data-v-12bbc91e">分</text></view></view></view><view wx:else class="countdown-card target-empty data-v-12bbc91e" bindtap="{{i}}"><text class="countdown-label data-v-12bbc91e">当前目标：{{h}}</text><text class="target-empty-text data-v-12bbc91e">设置考试日期，开启备考倒计时</text></view></view><view wx:if="{{j}}" class="load-error data-v-12bbc91e" bindtap="{{k}}"><text class="data-v-12bbc91e">首页数据加载失败，点击重试</text></view><view class="stats-row data-v-12bbc91e"><view class="stat-card data-v-12bbc91e"><text class="stat-num data-v-12bbc91e">{{l}}</text><text class="stat-label data-v-12bbc91e">今日刷题</text></view><view class="stat-card accent data-v-12bbc91e"><text class="stat-num data-v-12bbc91e">{{m}}%</text><text class="stat-label data-v-12bbc91e">正确率</text></view><view class="stat-card warning data-v-12bbc91e"><text class="stat-num data-v-12bbc91e">{{n}}</text><text class="stat-label data-v-12bbc91e">今日错题</text></view></view><view class="section data-v-12bbc91e"><text class="section-title data-v-12bbc91e">快速开始</text><view class="quick-actions data-v-12bbc91e"><view wx:for="{{o}}" wx:for-item="item" wx:key="e" class="{{['action-card', 'data-v-12bbc91e', item.d && 'primary']}}" bindtap="{{item.f}}"><view class="action-icon data-v-12bbc91e">{{item.a}}</view><text class="action-title data-v-12bbc91e">{{item.b}}</text><text class="action-desc data-v-12bbc91e">{{item.c}}</text></view></view></view><view wx:if="{{p}}" class="section data-v-12bbc91e"><view class="wrong-reminder data-v-12bbc91e" bindtap="{{r}}"><view class="reminder-left data-v-12bbc91e"><text class="reminder-icon data-v-12bbc91e">📝</text><view class="reminder-text data-v-12bbc91e"><text class="reminder-title data-v-12bbc91e">你有 {{q}} 道错题待复习</text><text class="reminder-desc data-v-12bbc91e">温故而知新，错题是进步的阶梯</text></view></view><text class="reminder-arrow data-v-12bbc91e">→</text></view></view><view class="section data-v-12bbc91e"><text class="section-title data-v-12bbc91e">最近试卷</text><view wx:if="{{s}}" class="paper-list data-v-12bbc91e"><view wx:for="{{t}}" wx:for-item="paper" wx:key="e" class="paper-item data-v-12bbc91e" bindtap="{{paper.f}}"><view class="paper-info data-v-12bbc91e"><text class="paper-title data-v-12bbc91e">{{paper.a}}</text><text class="paper-meta data-v-12bbc91e">{{paper.b}}题 · {{paper.c}}分</text></view><text class="paper-date data-v-12bbc91e">{{paper.d}}</text></view></view><view wx:else class="empty-state data-v-12bbc91e"><text class="empty-icon data-v-12bbc91e">📋</text><text class="empty-text data-v-12bbc91e">还没有做过试卷，快去刷题吧</text></view></view></view>