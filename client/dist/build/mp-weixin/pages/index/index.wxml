<view class="page data-v-ed0efbb5"><view class="header data-v-ed0efbb5"><view class="header-top data-v-ed0efbb5"><view class="greeting data-v-ed0efbb5"><text class="greeting-text data-v-ed0efbb5">{{a}}</text><text class="user-name data-v-ed0efbb5">{{b}}</text></view><view class="avatar data-v-ed0efbb5">😊</view></view><view wx:if="{{c}}" class="countdown-card data-v-ed0efbb5"><text class="countdown-label data-v-ed0efbb5">距 {{d}} 考试还有</text><view class="countdown-nums data-v-ed0efbb5"><view class="countdown-item data-v-ed0efbb5"><text class="countdown-num data-v-ed0efbb5">{{e}}</text><text class="countdown-unit data-v-ed0efbb5">天</text></view><text class="countdown-sep data-v-ed0efbb5">:</text><view class="countdown-item data-v-ed0efbb5"><text class="countdown-num data-v-ed0efbb5">{{f}}</text><text class="countdown-unit data-v-ed0efbb5">时</text></view><text class="countdown-sep data-v-ed0efbb5">:</text><view class="countdown-item data-v-ed0efbb5"><text class="countdown-num data-v-ed0efbb5">{{g}}</text><text class="countdown-unit data-v-ed0efbb5">分</text></view></view></view></view><view class="stats-row data-v-ed0efbb5"><view class="stat-card data-v-ed0efbb5"><text class="stat-num data-v-ed0efbb5">{{h}}</text><text class="stat-label data-v-ed0efbb5">今日刷题</text></view><view class="stat-card accent data-v-ed0efbb5"><text class="stat-num data-v-ed0efbb5">{{i}}%</text><text class="stat-label data-v-ed0efbb5">正确率</text></view><view class="stat-card warning data-v-ed0efbb5"><text class="stat-num data-v-ed0efbb5">{{j}}</text><text class="stat-label data-v-ed0efbb5">错题待复习</text></view></view><view class="section data-v-ed0efbb5"><text class="section-title data-v-ed0efbb5">快速开始</text><view class="quick-actions data-v-ed0efbb5"><view wx:for="{{k}}" wx:for-item="item" wx:key="e" class="{{['action-card', 'data-v-ed0efbb5', item.d && 'primary']}}" bindtap="{{item.f}}"><view class="action-icon data-v-ed0efbb5">{{item.a}}</view><text class="action-title data-v-ed0efbb5">{{item.b}}</text><text class="action-desc data-v-ed0efbb5">{{item.c}}</text></view></view></view><view wx:if="{{l}}" class="section data-v-ed0efbb5"><view class="wrong-reminder data-v-ed0efbb5" bindtap="{{n}}"><view class="reminder-left data-v-ed0efbb5"><text class="reminder-icon data-v-ed0efbb5">📝</text><view class="reminder-text data-v-ed0efbb5"><text class="reminder-title data-v-ed0efbb5">你有 {{m}} 道错题待复习</text><text class="reminder-desc data-v-ed0efbb5">温故而知新，错题是进步的阶梯</text></view></view><text class="reminder-arrow data-v-ed0efbb5">→</text></view></view><view class="section data-v-ed0efbb5"><text class="section-title data-v-ed0efbb5">最近试卷</text><view wx:if="{{o}}" class="paper-list data-v-ed0efbb5"><view wx:for="{{p}}" wx:for-item="paper" wx:key="e" class="paper-item data-v-ed0efbb5" bindtap="{{paper.f}}"><view class="paper-info data-v-ed0efbb5"><text class="paper-title data-v-ed0efbb5">{{paper.a}}</text><text class="paper-meta data-v-ed0efbb5">{{paper.b}}题 · {{paper.c}}分</text></view><text class="paper-date data-v-ed0efbb5">{{paper.d}}</text></view></view><view wx:else class="empty-state data-v-ed0efbb5"><text class="empty-icon data-v-ed0efbb5">📋</text><text class="empty-text data-v-ed0efbb5">还没有做过试卷，快去刷题吧</text></view></view></view>