.page.data-v-419be219 {
  min-height: 100vh;
  padding-bottom: 40rpx;
}
.score-header.data-v-419be219 {
  padding: 48rpx 32rpx 40rpx;
  text-align: center;
  background: linear-gradient(135deg, #10B981, #059669);
}
.score-header.failed.data-v-419be219 {
  background: linear-gradient(135deg, #F59E0B, #D97706);
}
.score-label.data-v-419be219 {
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
}
.score-ring.data-v-419be219 {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.4);
  margin: 24rpx auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.score-num.data-v-419be219 {
  font-size: 56rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1;
}
.score-unit.data-v-419be219 {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}
.score-stats.data-v-419be219 {
  display: flex;
  justify-content: center;
  gap: 48rpx;
}
.stat-item.data-v-419be219 {
  text-align: center;
}
.stat-value.data-v-419be219 {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  display: block;
}
.stat-desc.data-v-419be219 {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}
.section.data-v-419be219 {
  margin: 24rpx 24rpx 0;
}
.section-title.data-v-419be219 {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 16rpx;
  display: block;
}
.knowledge-list.data-v-419be219, .empty-state.data-v-419be219 {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}
.knowledge-item.data-v-419be219 {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.knowledge-item.data-v-419be219:last-child {
  margin-bottom: 0;
}
.knowledge-name.data-v-419be219 {
  width: 170rpx;
  font-size: 22rpx;
  color: #374151;
}
.knowledge-track.data-v-419be219 {
  flex: 1;
  height: 12rpx;
  background: #F3F4F6;
  border-radius: 6rpx;
  overflow: hidden;
}
.knowledge-fill.data-v-419be219 {
  height: 100%;
  background: #34D399;
  border-radius: 6rpx;
}
.knowledge-rate.data-v-419be219 {
  width: 72rpx;
  margin-left: 16rpx;
  text-align: right;
  font-size: 22rpx;
  color: #6B7280;
}
.empty-state.data-v-419be219 {
  font-size: 24rpx;
  color: #9CA3AF;
  text-align: center;
}
.time-bars.data-v-419be219 {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}
.time-bar-item.data-v-419be219 {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.time-bar-item.data-v-419be219:last-child {
  margin-bottom: 0;
}
.bar-label.data-v-419be219 {
  width: 80rpx;
  font-size: 22rpx;
  color: #6B7280;
}
.bar-track.data-v-419be219 {
  flex: 1;
  height: 12rpx;
  background: #F3F4F6;
  border-radius: 6rpx;
  margin: 0 16rpx;
  overflow: hidden;
}
.bar-fill.data-v-419be219 {
  height: 100%;
  background: #818CF8;
  border-radius: 6rpx;
}
.bar-time.data-v-419be219 {
  width: 60rpx;
  font-size: 22rpx;
  color: #6B7280;
  text-align: right;
}
.wrong-list.data-v-419be219 {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.wrong-item.data-v-419be219 {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  border-left: 4rpx solid #EF4444;
}
.wrong-stem.data-v-419be219 {
  font-size: 26rpx;
  color: #1F2937;
  line-height: 1.6;
  margin-bottom: 12rpx;
}
.wrong-info.data-v-419be219 {
  display: flex;
  gap: 24rpx;
}
.wrong-type.data-v-419be219 {
  font-size: 20rpx;
  color: #9CA3AF;
}
.wrong-your.data-v-419be219 {
  font-size: 20rpx;
  color: #EF4444;
}
.wrong-correct.data-v-419be219 {
  font-size: 20rpx;
  color: #10B981;
}
.actions.data-v-419be219 {
  padding: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.action-btn.data-v-419be219 {
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 20rpx 0;
  border: none;
  text-align: center;
}
.action-btn.primary.data-v-419be219 {
  background: linear-gradient(135deg, #4F46E5, #7C3AED);
  color: #fff;
}
.action-btn.secondary.data-v-419be219 {
  background: #EEF2FF;
  color: #4F46E5;
}
.action-btn.accent.data-v-419be219 {
  background: linear-gradient(135deg, #FEF3C7, #FDE68A);
  color: #92400E;
}