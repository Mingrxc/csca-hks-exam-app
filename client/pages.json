{
  "pages": [
    { "path": "pages/index/index", "style": { "navigationBarTitleText": "老外1点通" } },
    { "path": "pages/exam/index", "style": { "navigationBarTitleText": "刷题" } },
    { "path": "pages/exam/paper", "style": { "navigationBarTitleText": "组卷" } },
    { "path": "pages/exam/answer", "style": { "navigationBarTitleText": "答题中", "navigationStyle": "custom" } },
    { "path": "pages/exam/result", "style": { "navigationBarTitleText": "成绩报告" } },
    { "path": "pages/ai/index", "style": { "navigationBarTitleText": "AI问答" } },
    { "path": "pages/favorite/index", "style": { "navigationBarTitleText": "收藏题目" } },
    { "path": "pages/content-admin/index", "style": { "navigationBarTitleText": "内容管理" } },
    { "path": "pages/profile/index", "style": { "navigationBarTitleText": "个人信息" } },
    { "path": "pages/wrongbook/index", "style": { "navigationBarTitleText": "错题本" } },
    { "path": "pages/wrongbook/detail", "style": { "navigationBarTitleText": "错题详情" } },
    { "path": "pages/wrongbook/redo", "style": { "navigationBarTitleText": "错题重做", "navigationStyle": "custom" } }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "white",
    "navigationBarTitleText": "老外1点通",
    "navigationBarBackgroundColor": "#c77f5e",
    "backgroundColor": "#f7f1e8"
  },
  "tabBar": {
    "color": "#8d7f75",
    "selectedColor": "#c77f5e",
    "backgroundColor": "#fffaf3",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "static/tabbar/home.png",
        "selectedIconPath": "static/tabbar/home-active.png"
      },
      {
        "pagePath": "pages/exam/index",
        "text": "刷题",
        "iconPath": "static/tabbar/exam.png",
        "selectedIconPath": "static/tabbar/exam-active.png"
      },
      {
        "pagePath": "pages/ai/index",
        "text": "AI问答",
        "iconPath": "static/tabbar/ai.png",
        "selectedIconPath": "static/tabbar/ai-active.png"
      },
      {
        "pagePath": "pages/profile/index",
        "text": "个人信息",
        "iconPath": "static/tabbar/profile.png",
        "selectedIconPath": "static/tabbar/profile-active.png"
      }
    ]
  },
  "easycom": {
    "autoscan": true,
    "custom": {
      "^t-(.*)$": "@tdesign/uniapp/$1/$1.vue",
      "^c-question-item$": "@/components/QuestionItem/index.vue",
      "^c-countdown-bar$": "@/components/CountdownBar/index.vue",
      "^c-answer-card$": "@/components/AnswerCard/index.vue",
      "^c-ring-chart$": "@/components/RingChart/index.vue"
    }
  }
}
