# API（多个域名用英文逗号分隔；本地开发可使用 *）
CORS_ORIGINS=*

# 数据库
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=csca_hks_exam

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET_KEY=your-secret-key
JWT_EXPIRE_HOURS=72
AUTH_ALLOW_DEV_OPENID=true
DEV_OPENID=dev-openid

# 微信小程序
WX_APPID=your-appid
WX_SECRET=your-secret

# AI 问答（通义千问兼容模式）
QWEN_API_KEY=your-qwen-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus-2025-07-28
QWEN_TEMPERATURE=0.3
QWEN_MAX_TOKENS=1024
QWEN_TIMEOUT_SECONDS=45

# 在线内容管理管理员 OpenID（多个用英文逗号分隔）
CONTENT_ADMIN_OPENIDS=dev-openid
