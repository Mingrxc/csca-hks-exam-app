# API (comma-separated origins; use * only for local development)
APP_ENV=development
CORS_ORIGINS=*

# MySQL 8.4
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=deng
MYSQL_PASSWORD=
MYSQL_DATABASE=csca_hks_exam

# Redis (optional for the current application)
REDIS_HOST=localhost
REDIS_PORT=6379

# Authentication
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRE_HOURS=72
AUTH_ALLOW_DEV_OPENID=true
DEV_OPENID=dev-openid

# WeChat Mini Program (required in production)
WX_APPID=
WX_SECRET=

# AI assistant (Qwen OpenAI-compatible endpoint)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-27b
QWEN_TEMPERATURE=0.3
QWEN_MAX_TOKENS=1024
QWEN_TIMEOUT_SECONDS=45

# Question media: defaults to the sibling original_question_bank directory.
# QUESTION_BANK_ROOT=/opt/laowai/original_question_bank
# Optional HTTPS asset prefix; empty uses /api/v1/question/media.
QUESTION_MEDIA_BASE_URL=

# Content administrator OpenIDs (comma-separated)
CONTENT_ADMIN_OPENIDS=dev-openid
