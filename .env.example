# 后端模板。复制到 server/.env.local，已有配置请逐项核对。
# 前端请用 client/.env.example，分别复制到开发或生产模式的本地环境文件。

APP_ENV=development
CORS_ORIGINS=*

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=replace-with-database-user
MYSQL_PASSWORD=
MYSQL_DATABASE=csca_hks_exam

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=72
AUTH_ALLOW_DEV_OPENID=true
DEV_OPENID=dev-openid

# 真实微信登录需要小程序 AppID 和 AppSecret。
WX_APPID=
WX_SECRET=

# 空的媒体前缀使用 API 媒体路由。路径留空时请保留下面两项为注释以使用默认位置。
# QUESTION_BANK_ROOT=D:/path/to/original_question_bank
QUESTION_MEDIA_BASE_URL=
# USER_AVATAR_ROOT=D:/path/to/user_uploads/avatars

# AI 路由接回后才需要配置密钥。
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-27b
QWEN_TEMPERATURE=0.3
QWEN_MAX_TOKENS=1024
QWEN_TIMEOUT_SECONDS=45
